# Database
DATABASE_URL=sqlite:////data/newsrobot.db

# Server
PORT=8000
LOG_LEVEL=info
DEBUG=false
CORS_ORIGINS=*
SECRET_KEY=changeme-use-a-long-random-string
TZ=Europe/Brussels   # set your timezone so log timestamps are correct (e.g. Europe/Paris, America/New_York)

# AI (optional — set AI_ENABLED=false to disable)
AI_ENABLED=true
AI_PROVIDER=claude        # claude | openai | ollama | none
AI_API_KEY=               # required for claude and openai
AI_MODEL=claude-haiku-4-5-20251001   # or gpt-4o-mini, llama3.2
AI_BASE_URL=http://localhost:11434   # ollama only
AI_RELEVANCE_THRESHOLD=0.3           # articles below this score are discarded
